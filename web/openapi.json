{
  "components": {
    "schemas": {
      "EvalRunRequest": {
        "additionalProperties": false,
        "properties": {
          "compare_reranker": {
            "default": false,
            "title": "Compare Reranker",
            "type": "boolean"
          },
          "mode": {
            "default": "strict",
            "enum": [
              "strict",
              "explain"
            ],
            "title": "Mode",
            "type": "string"
          },
          "regenerate": {
            "default": false,
            "title": "Regenerate",
            "type": "boolean"
          }
        },
        "title": "EvalRunRequest",
        "type": "object"
      },
      "FeedbackFactsRequest": {
        "additionalProperties": false,
        "properties": {
          "key_facts": {
            "items": {
              "maxLength": 300,
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 1,
            "title": "Key Facts",
            "type": "array"
          },
          "source_sentence": {
            "default": "",
            "maxLength": 600,
            "title": "Source Sentence",
            "type": "string"
          }
        },
        "required": [
          "key_facts"
        ],
        "title": "FeedbackFactsRequest",
        "type": "object"
      },
      "FeedbackRequest": {
        "additionalProperties": false,
        "properties": {
          "note": {
            "default": "",
            "maxLength": 500,
            "title": "Note",
            "type": "string"
          },
          "rating": {
            "anyOf": [
              {
                "enum": [
                  "up",
                  "down"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          }
        },
        "required": [
          "rating"
        ],
        "title": "FeedbackRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ImportRequest": {
        "additionalProperties": false,
        "description": "Validate the public import boundary without a mutable runtime model.",
        "properties": {
          "url": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "ImportRequest",
        "type": "object"
      },
      "OverrideRequest": {
        "additionalProperties": false,
        "properties": {
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "relevance_override": {
            "default": false,
            "title": "Relevance Override",
            "type": "boolean"
          },
          "size_limit_mb": {
            "anyOf": [
              {
                "maximum": 25.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": 25,
            "title": "Size Limit Mb"
          }
        },
        "title": "OverrideRequest",
        "type": "object"
      },
      "PluginRequest": {
        "additionalProperties": false,
        "properties": {
          "config": {
            "additionalProperties": true,
            "title": "Config",
            "type": "object"
          },
          "plugin": {
            "title": "Plugin",
            "type": "string"
          }
        },
        "required": [
          "plugin"
        ],
        "title": "PluginRequest",
        "type": "object"
      },
      "QuestionRequest": {
        "additionalProperties": false,
        "properties": {
          "context": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context"
          },
          "history": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/QuestionTurn"
            },
            "maxItems": 4,
            "title": "History",
            "type": "array"
          },
          "mode": {
            "anyOf": [
              {
                "enum": [
                  "strict",
                  "explain"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode"
          },
          "question": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "QuestionRequest",
        "type": "object"
      },
      "QuestionTurn": {
        "additionalProperties": false,
        "description": "Bounded, untrusted pointers to earlier questions in the selected paper's chat.",
        "properties": {
          "question": {
            "maxLength": 700,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "source_ids": {
            "default": [],
            "items": {
              "maxLength": 256,
              "type": "string"
            },
            "maxItems": 8,
            "title": "Source Ids",
            "type": "array"
          }
        },
        "required": [
          "question"
        ],
        "title": "QuestionTurn",
        "type": "object"
      },
      "SyncConfig": {
        "additionalProperties": false,
        "description": "Validate unambiguous publication windows and bounded, resumable sync settings.",
        "properties": {
          "batch_size": {
            "default": 20,
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Batch Size",
            "type": "integer"
          },
          "end_month": {
            "anyOf": [
              {
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Month"
          },
          "initial_months": {
            "default": 6,
            "maximum": 120.0,
            "minimum": 1.0,
            "title": "Initial Months",
            "type": "integer"
          },
          "max_papers": {
            "default": 100,
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Max Papers",
            "type": "integer"
          },
          "mode": {
            "default": "relative",
            "enum": [
              "relative",
              "year",
              "month",
              "since",
              "range"
            ],
            "title": "Mode",
            "type": "string"
          },
          "month": {
            "anyOf": [
              {
                "maximum": 12.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Month"
          },
          "start_month": {
            "anyOf": [
              {
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Month"
          },
          "year": {
            "anyOf": [
              {
                "maximum": 9998.0,
                "minimum": 1991.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          }
        },
        "title": "SyncConfig",
        "type": "object"
      },
      "SyncRequest": {
        "additionalProperties": false,
        "properties": {
          "resume_job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resume Job Id"
          },
          "settings": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SyncConfig"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "default": "all",
            "title": "Source",
            "type": "string"
          }
        },
        "title": "SyncRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ARIE API",
    "version": "0.1.0"
  },
