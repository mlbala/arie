# ARIE environment. Copy to .env and fill in only what you use:
#   cp .env.example .env
# Empty or example values are treated as unconfigured. Keys stay on the server;
# the UI only shows whether each key is present and whether its connection check passes.

# --- LLM providers ---
# Required: ARIE's default model provider (deepseek-flash). Embeddings run locally.
DEEPSEEK_API_KEY=
# Optional, bring your own key: enables OpenAI or Gemini in Settings. Selecting one also
# switches embeddings to that provider while its key is set (Settings -> Embedder).
OPENAI_API_KEY=
GEMINI_API_KEY=
# Accepted as a fallback when GEMINI_API_KEY is empty.
# GOOGLE_API_KEY=

# --- MCP server ---
# Signs scoped /mcp/p/<handle> URLs. Set a long random value for any shared deployment:
#   openssl rand -hex 32
ARIE_MCP_SECRET=

# --- Docker Compose only ---
# Host port for the web workspace (http://localhost:8080).
ARIE_WEB_PORT=8080
# Host port for direct API / MCP access (bound to 127.0.0.1).
ARIE_API_PORT=8000
# Optional image extras, comma-separated. `docling` adds the OCR parser for scanned PDFs
# (adds PyTorch, CPU-only); then set plugins.parser.use: docling. Rebuild after changing.
ARIE_EXTRAS=
